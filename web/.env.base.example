# CrownFi Base migration (copy into .env.local; do not commit .env.local)
NEXT_PUBLIC_BASE_NETWORK="sepolia"

# Fresh Supabase project. Keep both values server-only.
DATABASE_URL="postgresql://postgres.<ref>:<encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Privy email/Google login + automatically-created EVM wallet.
# Vercel dashboard: paste values WITHOUT the surrounding quotes shown in this .env file.
# The App ID is the 25-character Application ID, not a client ID or App Secret.
NEXT_PUBLIC_PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_SECRET="your-server-only-privy-app-secret"


# Base/MetaMask admin wallet allowlist. Public addresses only; comma-separate multiple admins.
# Keep both values identical. ADMIN_WALLETS is the server-side security boundary;
# NEXT_PUBLIC_ADMIN_WALLETS only controls whether the admin UI is shown.
ADMIN_WALLETS=""
NEXT_PUBLIC_ADMIN_WALLETS=""
# Random cookie-signing secret; this is NOT a wallet key. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""
# Local: http://localhost:3000. Production: your exact HTTPS Vercel origin.
# Vercel dashboard: paste the URL without quotes.
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"

# Public development endpoints. Replace with a dedicated provider before production.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
NEXT_PUBLIC_BASE_MAINNET_RPC_URL="https://mainnet.base.org"

# Circle-issued native USDC on Base Sepolia. Mainnet uses
# 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913.
NEXT_PUBLIC_BASE_USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# Fill after deploying and verifying the EVM contracts on Base Sepolia.
NEXT_PUBLIC_BASE_VOTE_CONTRACT_ADDRESS=""
NEXT_PUBLIC_BASE_AUDIT_ANCHOR_ADDRESS="0xc7E6e385fCf5494cF740202c4E37fDD0977F0Be9"
NEXT_PUBLIC_BASE_COLLECTIBLE_CONTRACT_ADDRESS="0xaBF95a64439adc98cAaB2AA05806a9dbbC79219A"
NEXT_PUBLIC_BASE_PREDICTION_MARKET_ADDRESS="0x692c12283C2339021733a88Ba129556Ce73eff9c"
NEXT_PUBLIC_BASE_TICKET_CONTRACT_ADDRESS="0xD1013c0dEd496B75eE8e07d723807A7939bA205c"

# No browser wallet private key is required. Never add a private key with NEXT_PUBLIC_*.
# Store the deployment signer in an encrypted Foundry keystore or managed signer instead.

# --- Voting ---
# Simple per-account vote quota per round.
VOTE_QUOTA_PER_ROUND="1"

# --- Email notifications (Resend — free tier). Unset = emails are skipped (no-op). ---
# Get a key at https://resend.com (free). Use onboarding@resend.dev as sender for testing.
RESEND_API_KEY=""
EMAIL_FROM="CrownFi <onboarding@resend.dev>"

# --- Anti-abuse ---
MAX_ACCOUNTS_PER_IP="2"
